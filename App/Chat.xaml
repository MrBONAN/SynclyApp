<?xml version="1.0" encoding="utf-8"?>

<the49:BottomSheet xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:the49="https://schemas.the49.com/dotnet/2023/maui"
                   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                   x:Class="Chat.Sheet"
                   Padding="16, 32, 16, 72"
                   Background="{StaticResource Black}"
                   CornerRadius="20"
                   HasBackdrop="True">

    <the49:BottomSheet.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/BottomSheetStyle.xaml" />
                <ResourceDictionary Source="Resources/Styles/YourMessageStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </the49:BottomSheet.Resources>

    <the49:BottomSheet.Detents>
        <the49:FullscreenDetent />
    </the49:BottomSheet.Detents>

    <Grid VerticalOptions="Start"
          HorizontalOptions="FillAndExpand"
          RowSpacing="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Frame Grid.Column="0"
               x:Name="ProfileButton"
               CornerRadius="10"
               WidthRequest="50"
               HeightRequest="50"
               HorizontalOptions="Start">
            <ImageButton
                CornerRadius="10"
                Style="{StaticResource BaseButtonStyle}"
                Source="{Binding PartnerProfileImage}"
                WidthRequest="70"
                HeightRequest="70"
                HorizontalOptions="Center"
                Aspect="Center" />
        </Frame>

        <Label Grid.Column="1"
               x:Name="Username"
               Style="{StaticResource HeaderLabelStyle}"
               Text="{Binding PartnerUsername}"
               HorizontalOptions="CenterAndExpand" />

        <Button Grid.Column="2"
                x:Name="AddFriendButton"
                Style="{StaticResource BaseButtonStyle}"
                HorizontalOptions="End" />

        <ScrollView Grid.Row="1" Grid.ColumnSpan="3">
            <CollectionView ItemsSource="{Binding Messages}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame HorizontalOptions="{Binding Position}"
                               Style="{StaticResource FrameMessageStyle}">
                            <Label Text="{Binding MessageText}"
                                   Style="{StaticResource MessageTextStyle}" />
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>


        <Grid Grid.Row="2"
              Grid.ColumnSpan="3"
              ColumnSpacing="5"
              VerticalOptions="FillAndExpand"
              RowSpacing="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Editor
                x:Name="MessageEditor"
                Placeholder="Введите сообщение..."
                Grid.Column="0"
                VerticalOptions="Center"

                BackgroundColor="Black"
                TextColor="White"
                AutoSize="TextChanges"
                Margin="0"
                HeightRequest="50" />

            <ImageButton
                x:Name="SendMessageButton"
                Grid.Column="1"
                Source="chat_icon.png"
                HeightRequest="50"
                WidthRequest="50"
                VerticalOptions="Center"
                CornerRadius="5" />
        </Grid>
    </Grid>

</the49:BottomSheet>